{
  "name": "projectneb-pro-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProjectNeb Pro licensing, Discord OAuth and Boosty webhooks on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply projectneb-pro --local",
    "db:migrate:remote": "wrangler d1 migrations apply projectneb-pro --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@cloudflare/workers-types": "5.20261119.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.165.0"
  }
}
